# Public frontend setting, available to Vite at build time. No secrets here.
VITE_API_URL=https://your-api.example.com
# Backend only. Export these variables in your hosting settings; Vite does NOT load them for Node.
ENABLE_AUTH=true
AUTH_DB_PATH=./data/accounts.sqlite
PUBLIC_APP_URL=https://5yb6wsf8vv-gif.github.io/karate_kiokushinkai/
ALLOWED_ORIGINS=https://5yb6wsf8vv-gif.github.io
# Resend: verified sending domain and API key
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# VK ID web application (redirect URI must exactly match PUBLIC_APP_URL)
VK_CLIENT_ID=
